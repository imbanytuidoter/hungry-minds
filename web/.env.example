# Copy to .env.local to override where the web app points.
#
# Leave NEXT_PUBLIC_CONTRACT_ID out entirely -> the public testnet deploy
#   (hungry-minds-8250f6.testnet, see lib/chain.ts TESTNET_DEPLOY).
# Set it to an empty string -> offline mode (the /app demo world, preview art elsewhere).
# Set it to your own account -> your deploy.

# NEXT_PUBLIC_CONTRACT_ID=hungry-minds-8250f6.testnet
# NEXT_PUBLIC_NEAR_NETWORK=testnet
# First RPC tried; FastNEAR, dRPC and rpc.testnet.near.org follow as fallbacks.
# NEXT_PUBLIC_NEAR_RPC=https://test.rpc.fastnear.com
