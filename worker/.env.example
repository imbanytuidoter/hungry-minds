# Copy to .env and fill in. Never commit the real .env.

# The deployed Hungry Minds contract account.
CONTRACT_ID=hungry-minds.testnet

# The worker's own NEAR account + its full-access key (ed25519:...).
# A throwaway faucet account is fine: it answers thoughts, settles chats and jobs, and pays gas.
WORKER_ID=hm-worker.testnet
WORKER_KEY=ed25519:REPLACE_ME

# NEAR AI Cloud key (Bearer). A Private-TEE model gives a genuinely "verified" reply.
NEAR_AI_KEY=
# NEAR_AI_URL=https://cloud-api.near.ai/v1/chat/completions
# NEAR_AI_MODEL=Qwen/Qwen3.8-27B   # on NEAR AI's TEE fleet: every reply comes with the enclave's signature

# NEAR_NETWORK=testnet
# POLL_MS=3000
# NEAR_AI_TIMEOUT_MS=30000   # abort a hung NEAR AI request after this long
# MAX_ATTEMPTS=3             # give up on a request after N fails; it then times out on-chain (refund)

# Public origin of the site, used in the Minds' x402 cards (e.g. https://example.org).
# PUBLIC_SITE_URL=
# X402=off turns off the x402 door (/agent/x402/<mind id>).
